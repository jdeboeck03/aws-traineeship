{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/scan-git-secrets.sh",
            "timeout": 30,
            "statusMessage": "Scanning for secrets before git commit/push..."
          }
        ]
      }
    ]
  }
}

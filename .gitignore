# IDEA
.idea

# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# tfvars may contain secrets — do not commit
*.tfvars
*.tfvars.json

# Override files (local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# SSH private keys generated by Terraform
*.pem

# MkDocs build output
site/
